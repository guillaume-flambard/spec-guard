# Root-anchored on purpose: tests/fixtures deliberately contains directories
# named node_modules and dist, to prove the walker prunes them.
/node_modules
/dist
/coverage

# Package-scoped, not anchored to the root: each workspace package's own
# build output and dependency tree live one level down, under packages/*,
# and the two rules above do not reach there. These do not touch the
# fixtures under packages/*/tests/fixtures, since those live further down
# the tree (packages/*/tests/fixtures/.../node_modules, not packages/*/node_modules).
packages/*/node_modules
packages/*/dist
packages/*/coverage
# The prepack/postpack backup of a package.json being stripped for publish.
# Left on disk only when a pack is interrupted between the two; never meant
# to be committed even then, see scripts/strip-private-deps.mjs.
packages/*/package.json.orig
*.tgz
.DS_Store

# Scratch for subagent-driven execution. Never committed.
/.superpowers
